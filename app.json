{
  "expo": {
    "name": "Out Pass Register- Mist",
    "slug": "Out Pass Register- Mist",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "mistmess",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1218"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "bd.ac.mist.mess"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/mist-logo.png",
        "backgroundColor": "#0F1218"
      },
      "package": "bd.ac.mist.mess",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "Out Pass Register- Mist",
      "shortName": "OutPassRegister",
      "description": "A Daily Out Pass Register App for MIST Student Officers",
      "themeColor": "#B8922A",
      "backgroundColor": "#0F1218",
      "display": "standalone",
      "orientation": "portrait",
      "startUrl": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#B8922A",
          "sounds": []
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
