rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function getUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin()    { return isSignedIn() && getUser().role == 'admin'; }
    function isGSO2()     { return isSignedIn() && getUser().role == 'gso2'; }
    function isDeptHead() { return isSignedIn() && getUser().role == 'depthead'; }
    function isStudent()  { return isSignedIn() && getUser().role == 'student'; }

    match /users/{uid} {
      allow read: if isSignedIn();
      // Student can write their own doc (registration). Admin can write any.
      allow create: if request.auth.uid == uid;
      allow update: if request.auth.uid == uid || isAdmin();
      allow delete: if isAdmin();
    }

    match /requests/{reqId} {
      allow read: if isSignedIn();
      // Students create their own requests
      allow create: if isSignedIn() && isStudent();
      // GSO-2 and depthead can update (approve/reject/mark return)
      allow update: if isSignedIn() && (isAdmin() || isGSO2() || isStudent());
      // Students can cancel their own request while it's still pending
      allow delete: if isAdmin() || (isStudent() && resource.data.studentId == request.auth.uid && resource.data.status == 'pending');
    }

    match /notifications/{notifId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Notices: GSO-2 and dept heads publish, every signed-in user (students included) can read.
    match /notices/{noticeId} {
      allow read:   if isSignedIn();
      allow create: if isGSO2() || isDeptHead() || isAdmin();
      allow update, delete: if isGSO2() || isDeptHead() || isAdmin();
    }

    // Public lookup: service number → email only. Used for login before auth.
    match /serviceNumbers/{sn} {
      allow read:   if true;
      allow write:  if isSignedIn();
    }

  }
}
